# Secrets — never commit
scripts/pipeline/.env
**/.env
**/.env.local

# Plain-text secrets at repo root (passwords / API keys someone dropped in).
# Real home is ~/secrets/. This catches accidental `git add .`.
/*.txt

# Pipeline scratch — regenerable from source
scripts/pipeline/checkpoints/
scripts/pipeline/*.csv
/checkpoints/

# Local-only tooling state
.claude/
supabase/.temp/
supabase.exe

# Python
__pycache__/
*.pyc

# One-off analysis artifacts at repo root
/dup_report.txt
/dup_report_raw.json
/jurisdiction_disagree.csv

# Shared screenshots / external data dumps (workspace only)
share/
.venv-pipeline/
.tmp_dagster_home_*/

# Throwaway scratch — exploratory artifacts, tile caches, one-off CSVs
tmp/

# Trained model binaries — re-derivable from training data
scripts/output/

# Per-curator QGIS project files (user-specific paths)
QGIS/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
